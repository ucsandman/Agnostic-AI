# ==============================================================================
# Agnostic AI Universal Harness — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your environment variables.
# NEVER commit your actual .env file or sensitive keys to source control.

# --- DASHCLAW GOVERNED AUTONOMY (OPTIONAL) ---
# Optional governed autonomy for human-in-the-loop approval on high-risk operations.
# You can use a remote instance (e.g. Vercel), local instance (http://localhost:3000),
# or leave DASHCLAW_ACTIVE=false to run in 100% standalone mode.
DASHCLAW_ACTIVE=true
DASHCLAW_BASE_URL=https://my-dashclaw.vercel.app
DASHCLAW_API_KEY=
DASHCLAW_AGENT_ID=agnostic-harness
DASHCLAW_GUARD_MODE=enforce
DASHCLAW_RISK_THRESHOLD=50
DASHCLAW_PREDICTIVE_THRESHOLD=60
DASHCLAW_AUTO_SCAN_BLOCK=true

# --- LOCAL COMMAND CENTER ---
PORT=7842
PARITY_PORT=7843

# --- PROVIDER TELEMETRY & ALERTS (OPTIONAL) ---
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=

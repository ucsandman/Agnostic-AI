# Agnostic AI Harness - environment variable reference.
#
# Copy to .env if you like, but note: nothing in this repo auto-loads .env.
# Every variable below is read from the process environment (os.getenv /
# process.env). Export them in your shell or CI, or use your own .env loader.
# Never commit a real .env.

# --- Native coding agent: hosted model presets (agent/llm/client.py) -------
# `/model` switches between presets. Each hosted preset reads its key from the
# variable named here. Leave unset for local endpoints (LM Studio, Ollama) and
# for logged-in subscription bridges (agy / claude / codex CLIs).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alternative to GEMINI_API_KEY.
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- Native coding agent: generic OpenAI-compatible endpoint ---------------
# Used by the "local / custom" preset and the --url / --model / --api-key flags.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- DashClaw governed autonomy (optional) --------------------------------
# Configured ONLY from an explicit DASHCLAW_BASE_URL. Without it the harness
# runs on local guards from core/safety/guards.json, which fail closed.
DASHCLAW_BASE_URL=
DASHCLAW_API_KEY=
DASHCLAW_AGENT_ID=agnostic-harness
DASHCLAW_AGENT_NAME=Agnostic AI Harness

# --- Local web UIs (all bind 127.0.0.1 only) -----------------------------
PORT=7842           # command center (tools/dashboard)
RECALL_PORT=7844    # tools/recall
PARITY_PORT=7845    # tools/sync/parity
# The agent's web companion (`agnostic --web` or /web) listens on 7843.

# --- Engine storage overrides ---------------------------------------------
# Where harvest/distill/prune read and write candidates.jsonl, the digest and
# reports. Defaults to <repo>/storage. Mostly useful for tests.
AGNOSTIC_STORAGE=
# Where prune.cjs writes few-shot example fixtures. Defaults to core/examples.
AGNOSTIC_EXAMPLES_DIR=
# Folder the skill recommender and the dashboard Projects tab scan.
# Defaults to C:\Projects on Windows, ~/Projects elsewhere.
AGNOSTIC_PROJECTS_DIR=

# --- Test-only -------------------------------------------------------------
# ALLOW_HIGH_RISK is set by engine/tests/reg-hooks.cjs to prove the guard
# IGNORES it (fail-closed regression test). It has no effect on a real session.

# ==============================================================================
# Agnostic AI Universal Harness — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your environment variables.
# NEVER commit your actual .env file or sensitive keys to source control.
# Nothing here is auto-loaded from .env — these are read straight from the
# process environment (os.getenv / process.env), so export them in your
# shell/CI or wire your own .env loader before running the harness.

# --- DASHCLAW GOVERNED AUTONOMY (OPTIONAL) ---
# DashClaw is configured ONLY from an explicit DASHCLAW_BASE_URL. The harness no
# longer auto-adopts a server answering on a local port. Without these, the
# harness runs on 100% standalone local guards (which fail closed on high risk).
DASHCLAW_BASE_URL=
DASHCLAW_API_KEY=
DASHCLAW_AGENT_ID=agnostic-harness
DASHCLAW_AGENT_NAME=Agnostic AI Harness

# --- LOCAL COMMAND CENTER PORTS ---
PORT=7842
PARITY_PORT=7845
RECALL_PORT=7844

# --- NATIVE CODING AGENT (agent/llm/client.py) ---
# Used when pointing the `agnostic` agent at an OpenAI-compatible endpoint
# (LM Studio, Ollama, or a hosted API) instead of a native subscription.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

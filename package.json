    "errorlog": "node tools/errorlog/errorlog.cjs",
    "errorlog:ui": "node tools/errorlog/errorlog.cjs --open",
    "recall": "node tools/recall/recall.cjs",
    "parity": "node tools/sync/parity.cjs --open"
  },
  "keywords": ["ai", "harness", "agent", "agnostic", "claude", "gemini", "codex", "hermes", "openclaw"],

{
  "name": "agnostic-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Harness porter: captures the AI coding client you actually use (Claude Code or Codex) and applies its rules, hooks, skills, subagents, commands and MCP servers to every other client installed on the machine",
  "repository": {
    "type": "git",
    "url": "https://github.com/ucsandman/agnostic-harness.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "capture": "node engine/harness/cli.cjs capture",
    "apply": "node engine/harness/cli.cjs apply",
    "port": "node engine/harness/cli.cjs port",
    "port:check": "node engine/harness/cli.cjs port --check",
    "status": "node engine/harness/cli.cjs status",
    "status:open": "node engine/harness/cli.cjs status --html --open",
    "explain": "node engine/harness/cli.cjs explain",
    "launch": "node engine/setup/launch.cjs",
    "sync": "node engine/sync/sync.cjs",
    "sync:check": "node engine/sync/sync.cjs --check",
    "distill": "node engine/distill/distill.cjs",
    "test": "node engine/tests/run-all.cjs && node engine/tests/reg-sync.cjs && node engine/tests/reg-hooks.cjs && node engine/tests/reg-hook-protocol.cjs && node engine/tests/reg-hook-install.cjs && node engine/tests/reg-harness.cjs",
    "docs:targets": "node engine/docs/targets-doc.cjs",
    "docs:check": "node engine/docs/targets-doc.cjs --check",
    "merge": "node engine/ingest/merge.cjs",
    "merge:global": "node engine/ingest/merge.cjs --global",
    "dashboard": "node tools/dashboard/dashboard.cjs --open",
    "harvest": "node engine/harvest/harvest.cjs",
    "skills:consolidate": "node engine/skills/consolidate.cjs",
    "skills:recommend": "node engine/skills/recommend.cjs",
    "setup:default": "node engine/setup/first-run.cjs",
    "dashclaw:up": "npx dashclaw up --yes --no-browser",
    "dashclaw:doctor": "npx dashclaw doctor",
    "dashclaw:setup": "node engine/hooks/dashclaw-setup.cjs",
    "dashclaw:status": "node engine/hooks/dashclaw-setup.cjs --status",
    "recall": "node tools/recall/recall.cjs",
    "parity": "node tools/sync/parity.cjs --open"
  },
  "keywords": ["ai", "harness", "agent", "agnostic", "claude", "gemini", "codex", "hermes", "openclaw"],
  "author": "Wes Sander",
  "license": "MIT"
}

{
  "name": "agnostic-ai",
  "version": "1.5.1",
  "private": true,
  "description": "Model-agnostic AI agent harness: one rules file compiled to 16 AI coding clients, with safety hooks, a rule-distillation ladder, and a local command center",
  "repository": {
    "type": "git",
    "url": "https://github.com/ucsandman/agnostic-harness.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync": "node engine/sync/sync.cjs",
    "sync:check": "node engine/sync/sync.cjs --check",
    "distill": "node engine/distill/distill.cjs",
    "test": "node engine/tests/run-all.cjs && node engine/tests/reg-sync.cjs && node engine/tests/reg-hooks.cjs && node engine/tests/reg-hook-protocol.cjs && node engine/tests/reg-hook-install.cjs",
    "test:py": "python -m pytest tests/ -q",
    "lint": "ruff check .",
    "docs:targets": "node engine/docs/targets-doc.cjs",
    "docs:orchestration": "python -m agent.orchestration.docs",
    "docs:check": "node engine/docs/targets-doc.cjs --check && python -m agent.orchestration.docs --check",
    "merge": "node engine/ingest/merge.cjs",
    "merge:global": "node engine/ingest/merge.cjs --global",
    "dashboard": "node tools/dashboard/dashboard.cjs --open",
    "harvest": "node engine/harvest/harvest.cjs",
    "skills:consolidate": "node engine/skills/consolidate.cjs",
    "skills:recommend": "node engine/skills/recommend.cjs",
    "setup:default": "node engine/setup/first-run.cjs",
    "dashclaw:up": "npx dashclaw up --yes --no-browser",
    "dashclaw:doctor": "npx dashclaw doctor",
    "dashclaw:setup": "node engine/hooks/dashclaw-setup.cjs",
    "dashclaw:status": "node engine/hooks/dashclaw-setup.cjs --status",
    "recall": "node tools/recall/recall.cjs",
    "parity": "node tools/sync/parity.cjs --open",
    "agent": "python -m agent.tui",
    "agent:legacy": "python -m agent.cli",
    "agent:lmstudio": "python -m agent.tui --url http://localhost:1234/v1"
  },
  "keywords": ["ai", "harness", "agent", "agnostic", "claude", "gemini", "codex", "hermes", "openclaw"],
  "author": "Wes Sander",
  "license": "MIT"
}

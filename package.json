{
  "name": "agnostic-ai",
  "version": "1.0.0",
  "description": "Model-agnostic AI agent harness with continuous self-maintenance, polyglot sync, and guardrails",
  "main": "launch.py",
  "scripts": {
    "sync": "node engine/sync/sync.cjs",
    "sync:check": "node engine/sync/sync.cjs --check",
    "distill": "node engine/distill/distill.cjs",

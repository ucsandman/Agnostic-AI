.DS_Store
Thumbs.db
.vscode/
.idea/
.dashclaw-local/
.offlocal/
.agnostic/
# A project may intentionally version its orchestration policy; all runtime state stays ignored.
!.agnostic/
.agnostic/*
!.agnostic/orchestration.json
.frontend-verify/
.playwright-cli/

# vendored skill cache (rebuilt locally by consolidate.cjs)
skills/definitions/
# build/test caches
build/
agnostic_agent.egg-info/
.pytest_cache/
.ruff_cache/
__pycache__/
storage/backups/
storage/sync-state.json

# Generated runtime state (rebuilt by consolidate/harvest/prune on this machine)
storage/skills-manifest.json
storage/prune-report.json
storage/deleted-candidates.json

# codex rescue plugin resume notes
.agent-rescue/

# Runtime state written into linked directories (~/.claude/{hooks,mods,tools} are links into this repo).
# Per-machine, never tracked; `npm run doctor` lists anything else that appears here untracked.
engine/hooks/.fable-spawn-counts.json
engine/hooks/.subagent-budget-*.json
engine/hooks/.subagent-budget-*.jsonl
engine/hooks/__pycache__/
engine/mods/state/
tools/skillfind/index.json
tools/spend/spend-cache.json
tools/spend/spend.html
tools/gates/gates-report.html
tools/gates/references.json
tools/deskclaw/shots/
tools/deskclaw/logs/
tools/errorlog/errorlog.html
tools/*/out/
labs/procledger/ledger.jsonl

# The frozen-set lock is per machine (absolute paths, this install's hashes); regenerated by `node tools/gates/gates.cjs --lock`
tools/gates/gate-manifest.lock.json

# Local project config for this checkout (the operator's own CLAUDE.md and .claude/ settings), never the public harness
/CLAUDE.md
/.claude/

# Transcript-derived data never ships: session logs, audit trails, recordings, mined prompts (they stay in the private research repo)
labs/**/*.jsonl
labs/claude-mods/experiments/jev/*.json
labs/**/out/
labs/**/audit/
labs/**/logs/
labs/**/recordings/
labs/claude-mods/prototypes/prodguard/demo-state.json
